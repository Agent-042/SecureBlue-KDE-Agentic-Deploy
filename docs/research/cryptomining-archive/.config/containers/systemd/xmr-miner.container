[Unit]
Description=Rootless XMRig CPU Monero miner (RandomX)
Documentation=man:podman-systemd.unit(5)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/xmrig:latest
ContainerName=xmr-miner
# xmrig reads /etc/xmrig/config.json by default in many images; bind our config.
Volume=%h/.config/xmrig/config.json:/etc/xmrig/config.json:ro,Z
# Drop all capabilities and run as the container user for rootless safety.
DropCapability=ALL
NoNewPrivileges=true
AddCapability=IPC_LOCK
# Keep stdin open so xmrig can react to signals cleanly.
# (Uncomment if the image needs an interactive TTY.)
#TTY=true

[Service]
# Free-electricity optimization: do not throttle the miner.
#Nice=19
#CPUWeight=20
# Allow xmrig to lock memory for huge pages and the RandomX dataset.
LimitMEMLOCK=4G
Restart=always
RestartSec=10
# Ensure the container is removed on stop so Quadlet creates a fresh one.
ExecStopPost=-/usr/bin/podman rm -f xmr-miner

[Install]
WantedBy=default.target
