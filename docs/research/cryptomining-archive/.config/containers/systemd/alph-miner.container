[Unit]
Description=Rootless GPU profit-switching miner (MoneroOcean)
Documentation=man:podman-systemd.unit(5)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/mo-gpu-miner:latest
ContainerName=alph-miner
# CDI NVIDIA GPU passthrough. This requires the CDI spec to be generated first:
#   sudo nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml
# or, for rootless operation where the host CDI spec is readable:
#   nvidia-ctk cdi generate --output=~/.config/cdi/nvidia.yaml
AddDevice=nvidia.com/gpu=all
# Multi-miner profit-switching configuration
Volume=%h/.config/mo-gpu-miner/mm.json:/miner/mm.json:Z
# Drop capabilities; the miner should not need any.
DropCapability=ALL
NoNewPrivileges=true
ShmSize=2G

[Service]
Restart=always
RestartSec=30
# Disable swap for the miner service to avoid memory pressure spikes being paged out.
MemorySwapMax=0
ExecStopPost=-/usr/bin/podman rm -f alph-miner

[Install]
WantedBy=default.target
