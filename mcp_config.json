{
  "mcpServers": {
    "notebook": {
      "command": "npx",
      "args": [
        "-y",
        "git+https://github.com/gemini-cli-extensions/data-agent-kit-starter-pack.git",
        "--mode=notebook"
      ],
      "env": {
        "GOOGLE_CLOUD_PROJECT": "gen-lang-client-0385466726",
        "GCP_PROJECT": "gen-lang-client-0385466726",
        "GCP_REGION": "us-west1",
        "PATH": "/usr/local/bin:/usr/bin:/bin"
      }
    },
