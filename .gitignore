# Python virtual environments
venv/
.env
*.env

# Build artifacts
build/
out/
output/
*.tar
*.tar.*
*.img
*.iso
*.raw

# BlueBuild / Container outputs
containers/
cosign.key
cosign.pub

# Allow EasyEffects system-wide output presets despite generic output/ ignore.
!.backend/files/audio-eq/usr/etc/easyeffects/output/
!.backend/files/audio-eq/usr/etc/easyeffects/output/**

# Allow Podman Quadlet files despite generic containers/ ignore.
!.backend/files/local-ai/usr/share/containers/
!.backend/files/local-ai/usr/share/containers/**
!.backend/files/local-ai-amd-workstation/usr/share/containers/
!.backend/files/local-ai-amd-workstation/usr/share/containers/**
!.backend/files/local-ai-intel-g16/usr/share/containers/
!.backend/files/local-ai-intel-g16/usr/share/containers/**

# Secrets
*.key
*.sec1
*.pem
*.secret
secrets/
.pki/

# Cosign public key is required for image verification; do not ignore it.
!cosign.pub

# Backend legacy scripts and local script outputs (do not commit secrets)
.backend/scripts/legacy/*.env
.backend/scripts/legacy/*.secret
.backend/scripts/legacy/env-init-output*
__pycache__/
*.pyc

# Editor / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs
*.log

# Cryptomining artifacts (kept in separate BuildBlue docs repo; not part of image)
wallet_work/
*.miner
*-miner.container
mo-gpu-miner.Containerfile
cpu-miner.Containerfile
gpu-miner.Containerfile
mm.json
mining_stats.log
gpu_watchdog.log
idle_monitor.pid
