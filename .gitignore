# Python virtual environments
venv/
.env
*.env

# Build artifacts
build/
out/
output/
*.tar
*.tar.*
*.img
*.iso
*.raw

# BlueBuild / Container outputs
containers/
cosign.key
cosign.pub

# Allow EasyEffects system-wide output presets despite generic output/ ignore.
!files/audio-eq/usr/etc/easyeffects/output/
!files/audio-eq/usr/etc/easyeffects/output/**

# Allow Podman Quadlet files despite generic containers/ ignore.
!files/local-ai/usr/share/containers/
!files/local-ai/usr/share/containers/**
!files/local-ai-amd-workstation/usr/share/containers/
!files/local-ai-amd-workstation/usr/share/containers/**
!files/local-ai-intel-g16/usr/share/containers/
!files/local-ai-intel-g16/usr/share/containers/**

# Secrets
*.key
*.sec1
*.pem
*.secret
secrets/
.pki/

# Cosign public key is required for image verification; do not ignore it.
!cosign.pub

# Local script outputs / env derivatives (do not commit secrets)
scripts/*.env
scripts/*.secret
scripts/env-init-output*
__pycache__/
*.pyc

# Editor / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs
*.log
