DB_PATH = "/var/lib/agy/knowledge.db"

def init_db():
    os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS commands (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            subsystem TEXT,
            command TEXT,
            keywords TEXT,
            summary TEXT,
            example TEXT
        )
    """)
    
    # Check if table is populated
    cursor.execute("SELECT COUNT(*) FROM commands")
    if cursor.fetchone()[0] == 0:
        for entry in COMMAND_KNOWLEDGE_BASE:
            cursor.execute("""
                INSERT INTO commands (subsystem, command, keywords, summary, example)
                VALUES (?, ?, ?, ?, ?)
            """, (entry["subsystem"], entry["command"], json.dumps(entry["keywords"]), entry["summary"], entry["example"]))
        conn.commit()
    conn.close()

def search_commands(query: str, limit: int = 5) -> List[Dict[str, Any]]:
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("SELECT subsystem, command, keywords, summary, example FROM commands")
    rows = cursor.fetchall()
    conn.close()

    query_tokens = set(re.findall(r'\w+', query.lower()))
    results = []

    for row in rows:
        subsystem, cmd, keywords_json, summary, example = row
        keywords = json.loads(keywords_json)
        all_text = f"{subsystem} {cmd} {' '.join(keywords)} {summary}".lower()
        score = 0
        for token in query_tokens:
            if token in all_text:
                score += 1
                if token in cmd.lower():
                    score += 2
                if any(token in kw for kw in keywords):
                    score += 2

        if score > 0:
            results.append({
                "subsystem": subsystem,
                "command": cmd,
                "keywords": keywords,
                "summary": summary,
                "example": example,
                "score": score
            })

    results.sort(key=lambda x: x["score"], reverse=True)
    return results[:limit]

def dispatch_command(target: str, cmd: str):
    print(f"[*] Dispatching command to target [{target}]: {cmd}")
    if target == "local":
        res = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        print("--- Output ---")
        print(res.stdout)
        if res.stderr:
            print("--- Stderr ---")
            print(res.stderr)
        return res.returncode
    elif target in ["dom0", "sys-agent"] or target.startswith("qube:"):
        qube_target = target.replace("qube:", "")
        qrexec_cmd = f"echo {json.dumps(cmd)} | qrexec-client-vm {qube_target} agent.Dom0Exec"
        print(f"[*] Executing via Qrexec: {qrexec_cmd}")
        res = subprocess.run(qrexec_cmd, shell=True, capture_output=True, text=True)
        print(res.stdout)
        if res.stderr:
            print(res.stderr)
        return res.returncode
    else:
        print(f"[-] Unknown target: {target}")
        return 1

def main():
    parser = argparse.ArgumentParser(description="Agy - Universal Agentic CLI & RAG Assistant")
    parser.add_argument("query", nargs="*", help="Natural language query or command search")
    parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    parser.add_argument("--exec", action="store_true", help="Automatically execute top matched command")
    parser.add_argument("--target", default="local", help="Target host/qube for execution (local, dom0, sys-agent, qube:<name>)")
    parser.add_argument("--learn", action="store_true", help="Add new command entry to RAG database")
    parser.add_argument("--cmd", help="Command string for --learn")
    parser.add_argument("--summary", help="Summary for --learn")
    parser.add_argument("--subsystem", default="custom", help="Subsystem for --learn")

    args = parser.parse_args()
    init_db()

    if args.learn:
        if not args.cmd or not args.summary:
            print("Error: --cmd and --summary are required for --learn")
            sys.exit(1)
        conn = sqlite3.connect(DB_PATH)
        cursor = conn.cursor()
        keywords = re.findall(r'\w+', args.cmd.lower() + " " + args.summary.lower())
        cursor.execute("""
            INSERT INTO commands (subsystem, command, keywords, summary, example)
            VALUES (?, ?, ?, ?, ?)
        """, (args.subsystem, args.cmd, json.dumps(keywords), args.summary, args.cmd))
        conn.commit()
        conn.close()
        print(f"[+] Learned new command in '{args.subsystem}': {args.cmd}")
        sys.exit(0)

    if not args.query:
        parser.print_help()
        sys.exit(0)

    query_str = " ".join(args.query)
    matches = search_commands(query_str)

    if args.json:
        print(json.dumps(matches, indent=2))
        sys.exit(0)

    if not matches:
        print(f"[-] No exact RAG match for: '{query_str}'")
        print(f"[*] Fallback: Executing direct shell query...")
        dispatch_command(args.target, query_str)
        sys.exit(0)

    top_match = matches[0]
    print("\n=================================================================")
    print(f" 🤖 AGY CLI RAG MATCH [Subsystem: {top_match['subsystem']}]")
    print("=================================================================")
    print(f" Recommended Command : {top_match['example']}")
    print(f" Template Structure  : {top_match['command']}")
    print(f" Summary             : {top_match['summary']}")
    print("=================================================================\n")

    if len(matches) > 1:
        print("Related Commands:")
        for idx, match in enumerate(matches[1:], 1):
            print(f" [{idx}] {match['example']} - {match['summary']}")
        print()

    if args.exec:
        dispatch_command(args.target, top_match['example'])
    else:
        try:
            choice = input("Option: [e]xecute / [d]ispatch to dom0 / [c]opy / [a]bort -> ").strip().lower()
            if choice == 'e':
                dispatch_command("local", top_match['example'])
            elif choice == 'd':
                dispatch_command("dom0", top_match['example'])
            else:
                print("[-] Execution cancelled.")
        except (KeyboardInterrupt, EOFError):
            print("\n[-] Cancelled.")

if __name__ == "__main__":
    main()
