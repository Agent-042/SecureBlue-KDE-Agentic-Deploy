[Unit]
Description=Mining orchestrator startup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/systemctl --user daemon-reload
ExecStart=/usr/bin/systemctl --user start xmr-miner alph-miner mining-stats.service

[Install]
WantedBy=default.target
