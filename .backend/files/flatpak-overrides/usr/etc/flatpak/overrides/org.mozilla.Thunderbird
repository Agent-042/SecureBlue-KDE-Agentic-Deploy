[Context]
# Email client: allow network and selected filesystem access,
# but strip camera, microphone, background execution, and broad device access.
shared=network
# Restrict to Documents and Downloads for attachments; block host-level access.
filesystems=!host;!home;xdg-documents;xdg-download
# Remove camera/microphone/all device access.
devices=!all
# Prevent background execution / autostart.
features=!background

[Session Bus Policy]
# Keep email secrets isolated from the host secret service.
org.freedesktop.secrets=none
# Allow native notifications; block other desktop bus access.
org.freedesktop.Notifications=talk
org.kde.*=none
org.gnome.*=none
com.canonical.*=none

[System Bus Policy]
org.freedesktop.Avahi=none
