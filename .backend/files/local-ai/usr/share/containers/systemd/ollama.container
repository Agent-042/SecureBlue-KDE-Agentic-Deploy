# Ollama Quadlet targeting AMD Ryzen 7 7800X3D / Radeon iGPU via ROCm.
[Container]
Image=docker.io/ollama/ollama:rocm@sha256:0f56816ba03061337fed467bcf67336c69ba4dbb18a37f49c23d555d091519c0
ContainerName=ollama
# Persist downloaded models in a named Podman volume.
Volume=ollama:/root/.ollama
# Expose the Ollama API on localhost.
PublishPort=127.0.0.1:11434:11434
# GPU pass-through: AMD Radeon ROCm (/dev/dri for rendering, /dev/kfd for compute).
AddDevice=/dev/dri
AddDevice=/dev/kfd
# Required for direct GPU device access inside the container.
SecurityLabelDisable=true

[Service]
Restart=always

[Install]
# Enable with: systemctl --user enable ollama.service
WantedBy=default.target
